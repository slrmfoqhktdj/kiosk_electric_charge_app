<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.PaySelectFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        >



        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pay_select_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/pay_select_fragment_left_bg"
            >

            <ImageButton
                android:id="@+id/pay_card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.35"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.7"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent=".35"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent=".2"
                android:background="@drawable/pay_select_fragment_card_btn"
                tools:ignore="SpeakableTextPresentCheck"
                />

            <ImageButton
                android:id="@+id/pay_code"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.65"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.7"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent=".35"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent=".2"
                android:background="@drawable/pay_select_fragment_barcode_btn"
                tools:ignore="SpeakableTextPresentCheck"
                />

            <ImageButton
                android:id="@+id/pay_rfid"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.95"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.7"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent=".35"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent=".2"
                android:background="@drawable/pay_select_fragment_rfid_btn"
                tools:ignore="SpeakableTextPresentCheck"
                />


            <ImageButton
                android:id="@+id/back_btn"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.95"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.95"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent=".1"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent=".12"
                android:background="@drawable/bottomarrow_left"
                tools:ignore="SpeakableTextPresentCheck"
                />




        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>


</FrameLayout>