                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.875"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.66"

                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent=".11"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent=".14"

                tools:ignore="SpeakableTextPresentCheck" />










            <ImageButton
                android:id="@+id/pay_4000_btn"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/input_pay_fragment_4000_btn"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.35"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.83"

                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent=".11"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent=".14"

                tools:ignore="SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/pay_5000_btn"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/input_pay_fragment_5000_btn"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.525"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.83"

